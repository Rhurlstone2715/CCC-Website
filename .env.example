# Postgres connection string. On Railway this is set from the Postgres service.
DATABASE_URL="postgresql://user:password@localhost:5432/caymancrane"

# Separate database for `npm test`. The tests wipe it, so never point this at real data.
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/caymancrane_test"

# Email through Resend (optional). Without RESEND_API_KEY, bookings are still
# saved, and the page asks the customer to send their request by email instead.
RESEND_API_KEY=""
BOOKING_ALERT_TO="caymancrane@gmail.com"

# Sender for all email, on a domain verified in Resend. Leave empty to use
# Resend's test sender, which can only email the Resend account's own address:
# booking alerts still work, but customer emails (contracts, password resets) stay off.
EMAIL_FROM=""

# Lets someone with this code create an admin account at /admin/setup.
# Remove it once the admins are set up to turn that page off.
ADMIN_SETUP_CODE=""

# Base URL for links in emails, e.g. https://caymancrane.com. Defaults to the
# Railway domain, so only needed once a custom domain is live.
PUBLIC_URL=""
